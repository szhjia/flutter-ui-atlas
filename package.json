{
  "name": "flutter-ui-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A desktop canvas for Flutter routes, accounts, and navigation.",
  "engines": {
    "node": ">=22 <26.13"
  },
  "scripts": {
    "atlas": "node packages/cli/index.mjs",
    "dev": "vite --host 127.0.0.1 --port 60200 --strictPort",
    "test:demo": "npm run build && playwright test --config playwright.shop.config.ts",
    "test:demo:flutter": "cd demo && flutter analyze && flutter test",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"packages/**/*.{ts,tsx,mjs}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"examples/**/*.mjs\" \"playwright.shop.config.ts\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,mjs}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"examples/**/*.mjs\" \"playwright.shop.config.ts\"",
    "test": "npm run build && node --test tests/*.test.mjs && vitest run",
    "test:canvas": "vitest run",
    "test:browser": "playwright test",
    "pack:cli": "npm run build && node scripts/pack-cli.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "3.51.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "es-module-lexer": "2.3.2",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.8.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.16",
    "lightningcss-darwin-arm64": "1.33.0"
  },
  "packageManager": "pnpm@10.33.0"
}
